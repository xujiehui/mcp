# 在已登录的 Moonvy 页面 Console 执行 copy(window.app?.api?.$options?.token)
MOONVY_TOKEN=
MOONVY_ASSET_DIR=.moonvy/assets
MOONVY_PORT=3333
MOONVY_CACHE_TTL_MS=300000
MOONVY_CACHE_MAX_ENTRIES=20
MOONVY_CACHE_MAX_BYTES=134217728
MOONVY_MAX_RETRIES=2
MOONVY_RETRY_BASE_MS=200
MOONVY_MAX_GENOME_BYTES=52428800
MOONVY_MAX_ASSET_BYTES=20971520
MOONVY_MAX_IMAGE_BYTES=5242880
MOONVY_RESOURCE_MODE=text
MOONVY_TIMEOUT_MS=30000
MOONVY_ASSET_TTL_MS=604800000
MOONVY_ASSET_MAX_BYTES=536870912
MOONVY_COMPONENT_MAP=.moonvy/components.json
MOONVY_SNAPSHOT_DIR=.moonvy/snapshots
MOONVY_SNAPSHOT_TTL_MS=2592000000
MOONVY_SNAPSHOT_MAX_BYTES=134217728
MOONVY_SNAPSHOT_MAX_ENTRIES=20
